# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://librarycraft.aakasa.dev

# ---- Database ----
# Local: docker compose up -d
DATABASE_URL=postgresql://librarycraft:librarycraft@localhost:5432/librarycraft
# Vitest + Playwright use a separate database on the same server (created and reset automatically)
DATABASE_URL_TEST=postgresql://librarycraft:librarycraft@localhost:5432/librarycraft_test
# Production (Neon): pooled URL for the app, direct URL for migrations
# DATABASE_URL=postgresql://...-pooler.../librarycraft?sslmode=require
# DIRECT_URL=postgresql://.../librarycraft?sslmode=require

# ---- Auth.js ----
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to 1 to print magic links to the server log instead of emailing (e2e only; never in production)
AUTH_EMAIL_TO_CONSOLE=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="LibraryCraft <hello@librarycraft.aakasa.dev>"

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
STRIPE_PRICE_ORG_MONTHLY=
STRIPE_PRICE_ORG_YEARLY=

# ---- ISBN lookup ----
GOOGLE_BOOKS_API_KEY=   # optional, raises rate limits

# ---- Cover storage (Cloudflare R2 / S3) ----
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=librarycraft-covers
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_COVERS_BASE_URL=

# ---- Cover recognition (v1.1) ----
LLM_API_URL=https://llm.aakasa.dev
LLM_API_KEY=
LLM_VISION_MODEL=

# ---- Cron ----
CRON_SECRET=            # Vercel Cron sends this as a Bearer token

# ---- Monitoring ----
SENTRY_DSN=
